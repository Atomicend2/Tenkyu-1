# ============================================================
# TENKU BOT - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Your WhatsApp phone number (digits only, with country code, no + or spaces)
# Example: 2348144550593
BOT_PHONE_NUMBER=2348144550593

# Owner phone numbers (comma-separated, no + or spaces, E.164 digits only)
# This should match BOT_PHONE_NUMBER for single-owner setup
OWNER_NUMBERS=2348144550593

# Bot owner LID — the internal WhatsApp LID for the owner account.
# You can find this after first connection in the logs (look for "LID: 1xxxxx@lid").
# Use the digits-only part, e.g. 2348144550593
BOT_OWNER_LID=2348144550593

# Your Render/deployment website URL (used by .website command)
WEBSITE_URL=https://tenku.onrender.com

# Gemini API Key (for .ai / .gpt / .translate commands and bulk card upload)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key — powers Echidna (Witch of Greed AI character)
# Model used: openai/gpt-4o (routed through OpenRouter)
# Get your key at https://openrouter.ai — add credits, then copy the key.
# Note: This is an OpenRouter key, not a direct OpenAI key.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# JWT Secret for website authentication (use a long random string)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Server port (Render sets this automatically to 10000)
PORT=10000

# Node environment
NODE_ENV=production

# Persistent data directory — set this to a mounted disk path on Render (/data)
# Leave unset locally (defaults to ./data)
DATA_DIR=/data

# ── Shoob.gg Card Import ──────────────────────────────────────────────────────
# Required to import cards from shoob.gg via Admin Panel → "Import from Shoob.gg"
# or via the bot command: .fetchshoob T3 Anime 20
#
# How to get this value:
#   1. Log into https://shoob.gg in your browser
#   2. Open DevTools (F12) → Application tab → Cookies → https://shoob.gg
#   3. Find the cookie named  connect.sid  and copy its Value
#   4. Paste the full value below (it starts with s%3A or s: )
#
# Note: Sessions expire — if imports fail with "session expired", repeat the above steps.
SHOOB_SESSION=your_connect_sid_cookie_value_here
